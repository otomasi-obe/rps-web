# ===================================
# RPS Web Application Environment Variables
# ===================================

# CRITICAL: Set this when running on production server
# Must point to the Python API server URL that's accessible from the Next.js server
#
# Examples:
#   - Local development: http://127.0.0.1:5000
#   - Same server, different port: http://localhost:5000
#   - Docker container: http://python-api:5000
#   - Remote server: http://api.otomasi.app:5000
#
# DO NOT use 127.0.0.1 when Next.js and Python API run on different machines!
PYTHON_API_URL=http://127.0.0.1:5000

# For production domain:
# PYTHON_API_URL=http://python-api-internal:5000
# or
# PYTHON_API_URL=http://localhost:5000
